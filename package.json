{
  "name": "electron-vite-react-bettersql3",
  "private": true,
  "version": "0.0.1",
  "description": "Minimal Electron + React + Vite desktop app with Drizzle ORM and better-sqlite3.",
  "author": "Sezgin Bozdemir <sezdev@proton.me>",
  "type": "commonjs",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "electron-rebuild && vite",
    "build": "npm run db:generate && tsc -b && vite build && electron-rebuild && electron-builder",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "set ELECTRON_RUN_AS_NODE=true && electron ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "set ELECTRON_RUN_AS_NODE=true && electron ./node_modules/drizzle-kit/bin.cjs push",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-table-devtools": "^9.2.0",
    "@tanstack/router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@tsconfig/node22": "^22.0.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.10",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "globals": "^16.5.0",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.0.18"
  }
}
